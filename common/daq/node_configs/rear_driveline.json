{
  "$schema": "./can_schema.json",
  "busses": [
      {
        "bus_name": "VCAN",
        "nodes": [
          {
            "node_name": "rear_driveline",
            "can_peripheral": "CAN1",
            "tx": [
              {
                "msg_name":"rear_mag",
                "msg_desc":"magnetometer reading from rear bmm350 and rear mmc",
                "signals": [
                {
                  "sig_name":"mag_bmm350_rear",
                  "sig_desc": "Magnetic field in microteslas from bmm350",
                  "type":"int32_t",
                  "unit":"uT"
                },
                {
                  "sig_name":"rear_mag_mmc",
                  "sig_desc": "Magnetic field in microteslas from mmc",
                  "type":"int32_t",
                  "unit":"uT"
                }
                ],
                "msg_period": 15,
                "msg_priority": 3
              },
              {
                "msg_name": "rear_shock_driveline",
                "msg_desc": "Shockpot readings from rear left and rear right",
                "signals": [
                  {
                    "sig_name": "left_shock",
                    "sig_desc": "Travel distance of rear left shockpot",
                    "type": "int16_t",
                    "unit": "mm"
                  },
                  {
                    "sig_name": "right_shock",
                    "sig_desc": "Travel distance of rear right shockpot",
                    "type": "int16_t",
                    "unit": "mm"
                  }
                ],
                "msg_period": 15,
                "msg_priority": 3
              },
              {
                "msg_name": "rear_load_sensor_readings_driveline",
                "msg_desc": "Load Sensor readings from left and right",
                "signals": [
                  {
                    "sig_name": "left_load_sensor",
                    "sig_desc": "Left Normal Force",
                    "type": "float",
                    "unit": "N"
                  },
                  {
                    "sig_name": "right_load_sensor",
                    "sig_desc": "Right Normal Force",
                    "type": "float",
                    "unit": "N"
                  }
                ],
                "msg_period": 15,
                "msg_priority": 3
              },
              {
                "msg_name": "rear_brake_temps",
                "msg_desc":"IR temps from rear",
                "signals":[
                  {
                      "sig_name":"left_brake",
                      "sig_desc":"IR temp from rear left",
                      "type":"int16_t",
                      "unit":"degC"
                  },
                  {
                    "sig_name":"right_brake",
                    "sig_desc":"IR temp from rear right",
                    "type":"int16_t",
                    "unit":"degC"
                }
                ],
                "msg_period": 15,
                "msg_priority": 3
              }
             
            ],
            "rx":
             []
          }
        ]
      },
      {
        "bus_name": "TCAN",
        "nodes": [
          {
            "node_name": "rear_driveline",
            "can_peripheral": "CAN2",
            "tx": [
              {
                "msg_name": "rear_tire_temp_left",
                "msg_desc": "Forwarded raw tire temperature data from TCAN",
                "signals": [
                  { 
                    "sig_name": "tt_ch_1", "type": "uint16_t", "unit": "0.1degC" 
                  },
                  { "sig_name": "tt_ch_2", "type": "uint16_t", "unit": "0.1degC" 
                  },
                  { 
                    "sig_name": "tt_ch_3", "type": "uint16_t", "unit": "0.1degC" 
                  },
                  { "sig_name": "tt_ch_4", "type": "uint16_t", "unit": "0.1degC" 
                  }
                  
                ],
                "msg_period": 10,
                "msg_priority": 3
              },
              {
                "msg_name": "rear_tire_temp_right",
                "msg_desc": "Forwarded raw tire temperature data from TCAN",
                "signals": [
                  { 
                    "sig_name": "tt_ch_1", "type": "uint16_t", "unit": "0.1degC" 
                  },
                  { "sig_name": "tt_ch_2", "type": "uint16_t", "unit": "0.1degC" 
                  },
                  { 
                    "sig_name": "tt_ch_3", "type": "uint16_t", "unit": "0.1degC" 
                  },
                  { "sig_name": "tt_ch_4", "type": "uint16_t", "unit": "0.1degC" 
                  }
                ],
                "msg_period": 10,
                "msg_priority": 3
              }

              
            ],
            "rx": [
              
            ]
          }
        ]
      }
    ]
  }